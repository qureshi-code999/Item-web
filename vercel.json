{
  "version": 2,
  "rewrites": [
    {
      "source": "/(admin_server\\.js|admin_dashboard\\.html|.*\\.bak|.*\\.tmp|admin_config\\.json|supabase_config\\.json|dsr_data\\.json|purchase_rates\\.json|purchasing_.*\\.json|.*\\.secret|.*\\.sql|.*\\.properties|scratch/.*|apk/.*|complete/.*)",
      "destination": "/404"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
